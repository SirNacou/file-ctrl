{
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[go.mod]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "debug.javascript.autoAttachFilter": "disabled",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "files.readonlyInclude": {
    "**/*.gen.ts": true
  },
  "files.watcherExclude": {
    "**/*.gen.ts": true
  },
  "go.alternateTools": {
    "customFormatter": "golangci-lint-v2"
  },
  "go.formatFlags": [
    "fmt",
    "--stdin"
  ],
  "go.formatTool": "custom",
  "go.lintFlags": [
    "--path-mode=abs",
    "--fast-only"
  ],
  "go.lintTool": "golangci-lint-v2",
  "npm.scriptRunner": "vp",
  "oxc.configPath": "frontend/vite.config.ts",
  "oxc.disableNestedConfig": true,
  "oxc.enable": true,
  "oxc.fmt.configPath": "frontend/vite.config.ts",
  "oxc.fmt.disableNestedConfig": true,
  "oxc.path.oxfmt": "frontend/node_modules/.bin/oxlint",
  "oxc.path.oxlint": "frontend/node_modules/.bin/oxfmt",
  "pre-commit-helper.command": "task check:fix",
  "pre-commit-helper.runOnSave": "all hooks",
  "search.exclude": {
    "**/*.gen.ts": true
  }
}
