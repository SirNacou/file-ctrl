{
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "debug.javascript.autoAttachFilter": "disabled",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "go.alternateTools": {
    "customFormatter": "golangci-lint-v2"
  },
  "go.formatFlags": ["fmt", "--stdin"],
  "go.formatTool": "custom",
  "go.lintFlags": ["--path-mode=abs", "--fast-only"],
  "go.lintTool": "golangci-lint-v2",
  "npm.scriptRunner": "vp",
  "oxc.configPath": "frontend/vite.config.ts",
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "pre-commit-helper.command": "task check:fix",
  "pre-commit-helper.runOnSave": "all hooks",
  "search.exclude": {
    "**/routeTree.gen.ts": true
  }
}
