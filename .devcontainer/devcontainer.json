// For format details, see https://aka.ms. For config options, see the
// README at: https://github.com
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev
	"image": "://microsoft.com",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"version": "latest",
			"moby": "true"
		},
		"ghcr.io/devcontainers-extra/features/go-task:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/go:1": {
			"version": "latest"
		},
		"ghcr.io/mrsimonemms/devcontainers/air:1": {},
		"ghcr.io/devcontainers-extra/features/bun:1": {
			"version": "latest"
		}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Dynamically append the go-task completion hook into the Zsh profile
	"updateContentCommand": "mkdir -p ~/.zsh/completion && task --completion zsh > ~/.zsh/completion/_task && echo 'fpath=(~/.zsh/completion $fpath)\nautoload -Uz compinit && compinit' >> ~/.zshrc",
	// Use 'postStartCommand' to run commands after the container is created.
	"postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"redhat.vscode-yaml",
				"task.vscode-task",
				"oxc.oxc-vscode"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	}
	// Uncomment to connect as root instead. More info: https://aka.ms.
	// "remoteUser": "root"
}