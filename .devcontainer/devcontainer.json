// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "task.vscode-task",
        "oxc.oxc-vscode",
        "tamasfe.even-better-toml",
        "mamacarlos.envautoexample",
        "voidzero.vite-plus-extension-pack",
        "albert.tabout",
        "github.vscode-github-actions",
        "bradlc.vscode-tailwindcss",
        "dejmedus.tailwind-sorter",
        "esdete.tailwind-rainbow",
        "antfu.iconify",
        "elagil.pre-commit-helper",
        "renesaarsoo.sql-formatter-vsc"
      ],
      "settings": {
        "debug.javascript.autoAttachFilter": "disabled",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.env.linux": {
          "NODE_OPTIONS": ""
        }
      }
    }
  },
  // Uncomment to connect as root instead. More info: https://aka.ms.
  // "remoteUser": "root"
  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": {},
    "ghcr.io/devcontainers-extra/features/go-task:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    "ghcr.io/mrsimonemms/devcontainers/air:1": {},
    "ghcr.io/rafaph/devcontainer-features/goose-cli:1": {}
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": ["8080:8080"],
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "name": "Docker in Docker",
  "portsAttributes": {
    "3000": {
      "label": "frontend"
    },
    "8080": {
      "label": "backend"
    }
  },
  // Use 'postStartCommand' to run commands after the container is created.
  "postStartCommand": "git config --global --add safe.directory '*'",
  // Dynamically append the go-task completion hook into the Zsh profile
  "updateContentCommand": "mkdir -p ~/.zsh/completion && task --completion zsh > ~/.zsh/completion/_task && echo 'fpath=(~/.zsh/completion $fpath)\nautoload -Uz compinit && compinit' >> ~/.zshrc"
}
